{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huellaip.github.io/huellaip/esquema/huella-v0.schema.json",
  "title": "Huella de HuellaIP, formato v0",
  "description": "Archivo MUD (RFC 8520) con la extensión huellaip-perfil. Valida la estructura; las reglas que cruzan campos (R1 a R9) las verifica el validador. Ver especificacion/formato-huella-v0.md.",
  "type": "object",
  "required": ["ietf-mud:mud", "ietf-access-control-list:acls"],
  "additionalProperties": false,
  "properties": {
    "ietf-mud:mud": { "$ref": "#/$defs/mud" },
    "ietf-access-control-list:acls": { "$ref": "#/$defs/acls" }
  },
  "$defs": {
    "dominio": {
      "description": "Nombre DNS exacto, en minúsculas y sin punto final. La última etiqueta tiene que tener al menos una letra, así que no se aceptan direcciones IP.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+(?=[a-z0-9-]*[a-z])[a-z0-9-]{2,63}$"
    },
    "dominio-o-comodin": {
      "description": "Nombre DNS exacto o con un comodín en la etiqueta de más a la izquierda (*.dispositivos.ejemplo.com). Solo se usa en la extensión: MUD no admite comodines.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+(?=[a-z0-9-]*[a-z])[a-z0-9-]{2,63}$"
    },
    "uri-https": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fecha-hora": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "entero-no-negativo": { "type": "integer", "minimum": 0 },
    "asn": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "nombre-estado": { "enum": ["encendido", "reposo", "activo", "interaccion"] },
    "red-ipv4": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$"
    },
    "puerto": { "type": "integer", "minimum": 0, "maximum": 65535 },

    "mud": {
      "type": "object",
      "required": [
        "mud-version", "mud-url", "last-update", "is-supported", "systeminfo",
        "mfg-name", "model-name", "firmware-rev", "extensions",
        "from-device-policy", "to-device-policy", "huellaip-perfil:perfil"
      ],
      "additionalProperties": false,
      "properties": {
        "mud-version": { "const": 1 },
        "mud-url": {
          "description": "https://huellaip.github.io/huellas/<categoria>/<fabricante>/<modelo>/<firmware>.json",
          "type": "string",
          "pattern": "^https://huellaip\\.github\\.io/huellas/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9._-]+\\.json$"
        },
        "last-update": { "$ref": "#/$defs/fecha-hora" },
        "mud-signature": { "$ref": "#/$defs/uri-https" },
        "cache-validity": { "type": "integer", "minimum": 1, "maximum": 168 },
        "is-supported": { "type": "boolean" },
        "systeminfo": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mfg-name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model-name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "firmware-rev": { "type": "string", "minLength": 1, "maxLength": 100 },
        "software-rev": { "type": "string", "minLength": 1, "maxLength": 100 },
        "documentation": { "$ref": "#/$defs/uri-https" },
        "extensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 },
          "uniqueItems": true,
          "contains": { "const": "huellaip-perfil" }
        },
        "from-device-policy": { "$ref": "#/$defs/politica" },
        "to-device-policy": { "$ref": "#/$defs/politica" },
        "ietf-mud-tls:is-tls-dtls-profile-supported": { "type": "boolean" },
        "huellaip-perfil:perfil": { "$ref": "#/$defs/perfil" }
      }
    },

    "politica": {
      "type": "object",
      "required": ["access-lists"],
      "properties": {
        "access-lists": {
          "type": "object",
          "required": ["access-list"],
          "properties": {
            "access-list": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },

    "acls": {
      "type": "object",
      "required": ["acl"],
      "properties": {
        "acl": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acl" } }
      }
    },
    "acl": {
      "type": "object",
      "required": ["name", "type", "aces"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "ipv4-acl-type", "description": "En v0 solo IPv4." },
        "aces": {
          "type": "object",
          "required": ["ace"],
          "properties": {
            "ace": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ace" } }
          }
        }
      }
    },
    "ace": {
      "type": "object",
      "required": ["name", "matches", "actions"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "matches": {
          "type": "object",
          "properties": {
            "ipv4": {
              "type": "object",
              "properties": {
                "protocol": { "type": "integer", "minimum": 0, "maximum": 255 },
                "ietf-acldns:dst-dnsname": { "$ref": "#/$defs/dominio" },
                "ietf-acldns:src-dnsname": { "$ref": "#/$defs/dominio" },
                "destination-ipv4-network": { "$ref": "#/$defs/red-ipv4" },
                "source-ipv4-network": { "$ref": "#/$defs/red-ipv4" }
              }
            },
            "tcp": { "$ref": "#/$defs/capa4" },
            "udp": { "$ref": "#/$defs/capa4" },
            "ietf-acl-tls:client-profiles": {
              "description": "Perfiles (D)TLS del RFC 9761. Solo admite TLS 1.2 y 1.3.",
              "type": "object",
              "required": ["tls-dtls-profile"],
              "properties": {
                "tls-dtls-profile": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
                      "supported-tls-version": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": { "enum": ["tls12", "tls13"] }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "actions": {
          "type": "object",
          "required": ["forwarding"],
          "properties": { "forwarding": { "enum": ["accept", "drop", "reject"] } }
        }
      }
    },
    "capa4": {
      "type": "object",
      "properties": {
        "ietf-mud:direction-initiated": { "enum": ["from-device", "to-device"] },
        "source-port": { "$ref": "#/$defs/puerto-o-rango" },
        "destination-port": { "$ref": "#/$defs/puerto-o-rango" }
      }
    },
    "puerto-o-rango": {
      "oneOf": [
        {
          "type": "object",
          "required": ["operator", "port"],
          "additionalProperties": false,
          "properties": {
            "operator": { "enum": ["eq", "lte", "gte", "neq"] },
            "port": { "$ref": "#/$defs/puerto" }
          }
        },
        {
          "type": "object",
          "required": ["lower-port", "upper-port"],
          "additionalProperties": false,
          "properties": {
            "lower-port": { "$ref": "#/$defs/puerto" },
            "upper-port": { "$ref": "#/$defs/puerto" }
          }
        }
      ]
    },

    "perfil": {
      "description": "Extensión huellaip-perfil: comportamiento observado por estado de uso.",
      "type": "object",
      "required": ["version-formato", "categoria", "etiqueta", "captura", "estados", "licencia"],
      "additionalProperties": false,
      "properties": {
        "version-formato": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
        "categoria": {
          "enum": [
            "televisor", "streaming", "tv-box", "camara", "impresora",
            "router", "asistente", "enchufe", "electrodomestico"
          ]
        },
        "etiqueta": { "enum": ["benigno", "sospechoso", "malicioso"] },
        "fuentes-ioc": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uri-https" }
        },
        "observaciones": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "identificacion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oui": {
              "description": "Solo los tres primeros bytes de la MAC, en mayúsculas. Nunca la MAC completa.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9A-F]{2}:[0-9A-F]{2}:[0-9A-F]{2}$" }
            }
          }
        },
        "captura": {
          "type": "object",
          "required": ["pais", "fecha-inicio", "fecha-fin", "aportante", "confianza"],
          "additionalProperties": false,
          "properties": {
            "pais": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "fecha-inicio": { "$ref": "#/$defs/fecha" },
            "fecha-fin": { "$ref": "#/$defs/fecha" },
            "aportante": { "type": "string", "minLength": 1, "maxLength": 200 },
            "confianza": { "enum": ["baja", "media", "alta"] },
            "fuente-asn": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "estados": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nombre-estado" },
          "additionalProperties": { "$ref": "#/$defs/estado" }
        },
        "estados-omitidos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["estado", "motivo"],
            "additionalProperties": false,
            "properties": {
              "estado": { "$ref": "#/$defs/nombre-estado" },
              "motivo": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        "licencia": { "const": "CC-BY-4.0" }
      },
      "allOf": [
        {
          "if": { "properties": { "etiqueta": { "const": "malicioso" } }, "required": ["etiqueta"] },
          "then": { "required": ["fuentes-ioc"] }
        },
        {
          "if": { "properties": { "etiqueta": { "const": "sospechoso" } }, "required": ["etiqueta"] },
          "then": { "required": ["observaciones"] }
        }
      ]
    },

    "estado": {
      "type": "object",
      "required": [
        "muestra", "sesiones-concurrentes", "bytes-subida-hora-p95", "bytes-bajada-hora-p95",
        "conexiones-nuevas-min-p95", "destinos", "asn-esperados"
      ],
      "additionalProperties": false,
      "properties": {
        "muestra": {
          "type": "object",
          "required": ["sesiones", "minutos"],
          "additionalProperties": false,
          "properties": {
            "sesiones": { "type": "integer", "minimum": 1 },
            "minutos": { "type": "integer", "minimum": 1 }
          }
        },
        "sesiones-concurrentes": {
          "type": "object",
          "required": ["p50", "p95", "max"],
          "additionalProperties": false,
          "properties": {
            "p50": { "$ref": "#/$defs/entero-no-negativo" },
            "p95": { "$ref": "#/$defs/entero-no-negativo" },
            "max": { "$ref": "#/$defs/entero-no-negativo" }
          }
        },
        "bytes-subida-hora-p95": { "$ref": "#/$defs/entero-no-negativo" },
        "bytes-bajada-hora-p95": { "$ref": "#/$defs/entero-no-negativo" },
        "conexiones-nuevas-min-p95": { "$ref": "#/$defs/entero-no-negativo" },
        "keepalive-segundos": { "type": "integer", "minimum": 1 },
        "destinos": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dominio-o-comodin" }
        },
        "asn-esperados": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/asn" }
        },
        "versiones-tls": {
          "description": "Versiones observadas. Incluye TLS 1.0 y 1.1, que son una señal en sí mismas aunque el RFC 9761 no las admita en las ACL.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["tls10", "tls11", "tls12", "tls13"] }
        }
      }
    }
  }
}
