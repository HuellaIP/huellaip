# Copy to .env and uncomment what you want to change. Every variable is optional.

# UDP port for IPFIX / NetFlow v9 / v5
# LISTEN_PORT=2055

# Days the closed hourly files are kept
# RETENTION_DAYS=90

# Below this free space (GB) the oldest files are deleted; if that is not enough,
# writing pauses and the container reports unhealthy
# MIN_FREE_GB=5

# Seconds between flushes to disk (at most this much is lost on a power cut)
# FLUSH_SECONDS=5

# Percentage of packets GoFlow2 may drop for a missing template between two checks
# (every 60 s) before the container reports unhealthy
# MAX_DROP_PERCENT=1

# Extra GoFlow2 options, for special cases
# GOFLOW2_EXTRA_ARGS=
